---
import { getAdminFromRequest, ensureInitialAdmin } from '../lib/auth.js';
import '../styles/global.scss';
import '../styles/globals.css';

interface Props {
  title?: string;
  activeNav?: 'overview' | 'events' | 'tickets' | 'orders' | 'verifications';
}

const { title = 'Admin Dashboard', activeNav = 'overview' } = Astro.props;

// Ensure bootstrap admin exists
ensureInitialAdmin();

// Server-side authentication check
const auth = getAdminFromRequest(Astro.request, Astro.cookies);

if (!auth) {
  return Astro.redirect('/admin/login');
}

const { user } = auth;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | GeoHabari Admin</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <!-- SIDEBAR -->
      <aside class="admin-sidebar" id="adminSidebar">
        <div class="sidebar-brand">
          <a href="/admin" class="brand-link">
            <span class="brand-icon">GH</span>
            <div class="brand-text">
              <span class="brand-title">GeoHabari</span>
              <span class="brand-subtitle">Admin Portal</span>
            </div>
          </a>
          <button class="mobile-close-btn" id="mobileCloseBtn" aria-label="Close menu">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <nav class="sidebar-nav">
          <div class="nav-section-title">Operations</div>
          <a href="/admin" class={`nav-item ${activeNav === 'overview' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="7" height="9" x="3" y="3" rx="1"/>
              <rect width="7" height="5" x="14" y="3" rx="1"/>
              <rect width="7" height="9" x="14" y="12" rx="1"/>
              <rect width="7" height="5" x="3" y="16" rx="1"/>
            </svg>
            <span>Overview</span>
          </a>

          <a href="/admin/events" class={`nav-item ${activeNav === 'events' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            <span>Events</span>
          </a>

          <a href="/admin/tickets" class={`nav-item ${activeNav === 'tickets' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
              <path d="M13 5v2"/>
              <path d="M13 17v2"/>
              <path d="M13 11v2"/>
            </svg>
            <span>Ticket Holders</span>
          </a>

          <a href="/admin/orders" class={`nav-item ${activeNav === 'orders' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="14" x="2" y="5" rx="2"/>
              <line x1="2" x2="22" y1="10" y2="10"/>
            </svg>
            <span>Orders & Ledger</span>
          </a>

          <a href="/admin/verifications" class={`nav-item ${activeNav === 'verifications' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span>Student Verifications</span>
          </a>

          <div class="nav-section-title">Data & Quick Actions</div>
          <a href="/api/admin/exports" class="nav-item export-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Download All (CSV)</span>
          </a>

          <a href="/events" target="_blank" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" x2="21" y1="14" y2="3"/>
            </svg>
            <span>View Public Site</span>
          </a>
        </nav>

        <!-- USER FOOTER -->
        <div class="sidebar-user">
          <div class="user-meta">
            <div class="user-avatar">{user.full_name.slice(0, 2).toUpperCase()}</div>
            <div class="user-info">
              <span class="user-name">{user.full_name}</span>
              <span class="user-role">{user.role}</span>
            </div>
          </div>
          <a href="/api/admin/logout" class="logout-btn" title="Sign out">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" x2="9" y1="12" y2="12"/>
            </svg>
          </a>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <div class="admin-main">
        <!-- TOPBAR -->
        <header class="admin-topbar">
          <div class="topbar-left">
            <button class="mobile-toggle-btn" id="mobileToggleBtn" aria-label="Open menu">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="4" x2="20" y1="12" y2="12"/>
                <line x1="4" x2="20" y1="6" y2="6"/>
                <line x1="4" x2="20" y1="18" y2="18"/>
              </svg>
            </button>
            <h1 class="topbar-page-title">{title}</h1>
          </div>

          <div class="topbar-right">
            <div class="status-indicator">
              <span class="pulse-dot"></span>
              <span class="status-text">Production Ledger Active</span>
            </div>
            <a href="/api/admin/exports" class="topbar-export-btn">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
              <span>Export CSV</span>
            </a>
          </div>
        </header>

        <!-- PAGE CONTENT INJECTION -->
        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const toggleBtn = document.getElementById('mobileToggleBtn');
      const closeBtn = document.getElementById('mobileCloseBtn');
      const sidebar = document.getElementById('adminSidebar');

      if (toggleBtn && sidebar) {
        toggleBtn.addEventListener('click', () => {
          sidebar.classList.add('open');
        });
      }

      if (closeBtn && sidebar) {
        closeBtn.addEventListener('click', () => {
          sidebar.classList.remove('open');
        });
      }
    </script>
  </body>
</html>

<style lang="scss">
  @use "../styles/partials/combined.scss" as *;

  :global(.admin-body) {
    margin: 0;
    padding: 0;
    background-color: #0b0d17;
    color: #f3f4f6;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .admin-shell {
    display: flex;
    min-height: 100vh;
  }

  /* SIDEBAR */
  .admin-sidebar {
    width: 270px;
    background: #0f1221;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    z-index: 100;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sidebar-brand {
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, $purple, $green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    color: white;
    box-shadow: 0 4px 14px rgba(108, 43, 217, 0.4);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mobile-close-btn {
    display: none;
    background: transparent;
    border: none;
    color: #9ca3af;
    cursor: pointer;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1.25rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    overflow-y: auto;
  }

  .nav-section-title {
    font-size: 0.7rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.75rem 0.75rem 0.35rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    color: #d1d5db;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.15s ease;

    &:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #ffffff;
    }

    &.active {
      background: rgba(108, 43, 217, 0.25);
      border-left: 3px solid $green;
      color: #ffffff;
      font-weight: 600;

      .nav-icon {
        color: $green;
      }
    }
  }

  .nav-icon {
    width: 18px;
    height: 18px;
    color: #9ca3af;
    flex-shrink: 0;
  }

  .export-link {
    color: $green-light;
    &:hover {
      background: rgba(141, 198, 63, 0.12);
      color: #ffffff;
    }
  }

  .sidebar-user {
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.2);
  }

  .user-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  .user-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .user-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-role {
    font-size: 0.7rem;
    color: $green;
    text-transform: capitalize;
  }

  .logout-btn {
    color: #9ca3af;
    padding: 0.4rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.15s ease;

    &:hover {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
    }
  }

  /* MAIN AREA */
  .admin-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .admin-topbar {
    height: 70px;
    background: rgba(15, 18, 33, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-toggle-btn {
    display: none;
    background: transparent;
    border: none;
    color: #e5e7eb;
    cursor: pointer;
  }

  .topbar-page-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #9ca3af;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: $green;
    box-shadow: 0 0 10px rgba(141, 198, 63, 0.6);
  }

  .topbar-export-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f3f4f6;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;

    &:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.2);
    }
  }

  .admin-content {
    flex: 1;
    padding: 2rem;
    max-width: 1500px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .admin-sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      transform: translateX(-100%);
    }

    .admin-sidebar.open {
      transform: translateX(0);
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.8);
    }

    .mobile-close-btn {
      display: block;
    }

    .mobile-toggle-btn {
      display: block;
    }

    .admin-topbar {
      padding: 0 1.25rem;
    }

    .admin-content {
      padding: 1.25rem;
    }

    .status-indicator {
      display: none;
    }
  }
</style>
