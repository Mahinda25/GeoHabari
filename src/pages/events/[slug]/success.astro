---
import Layout from "../../../layout/Layout.astro";
import { getEventBySlug, getOrderByReference } from "../../../lib/ticketing-store.js";
const { slug } = Astro.params;
const reference = Astro.url.searchParams.get("reference");
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
const event = await getEventBySlug(slug);
const order = reference ? await getOrderByReference(reference) : null;
const orderMatchesEvent = Boolean(event && order && order.event_id === event.id);
const paymentStatus = orderMatchesEvent ? order.status : "not_found";
Astro.response.headers.set("Cache-Control", "no-store, private, max-age=0, must-revalidate");
Astro.response.headers.set("Pragma", "no-cache");
---

<Layout
  title={paymentStatus === "paid" ? "Ticket confirmed" : "Payment status"}
  description="Check the status of your event ticket payment."
  url={canonicalUrl}
>
  <div class="success-shell">
    <div class="success-card">
      {paymentStatus === "paid" ? (
        <>
          <span class="badge">Confirmed</span>
          <h1>Tickets are ready.</h1>
          <p>Your payment is confirmed. Ticket details will be sent to the purchaser's email and, when configured, WhatsApp.</p>
        </>
      ) : paymentStatus === "pending" || paymentStatus === "processing" || (paymentStatus === "not_found" && reference) ? (
        <>
          <span class="badge checking-badge" id="payment-status-badge">Checking payment</span>
          <h1 id="payment-status-heading">We are confirming your payment.</h1>
          <div class="payment-spinner" id="payment-status-spinner" role="status" aria-label="Checking payment status"></div>
          <p id="payment-status-message" aria-live="polite">We are checking your transaction with Paystack. This page will update automatically.</p>
          <p id="payment-failure-notice" class="payment-failure-notice" role="alert" hidden>
            Paystack did not confirm this payment. No tickets were issued. You can return to checkout to try again.
          </p>
          <a href="/checkout" class="primary-btn" id="payment-checkout-link" hidden>Return to checkout</a>
        </>
      ) : paymentStatus === "failed" || paymentStatus === "cancelled" ? (
        <>
          <span class="badge failed-badge">Payment not completed</span>
          <h1>Your tickets were not issued.</h1>
          <p>The payment provider did not confirm payment. Contact the event organizer if you believe this is incorrect.</p>
          <a href="/checkout" class="primary-btn">Return to checkout</a>
        </>
      ) : (
        <>
          <span class="badge failed-badge">Reference unavailable</span>
          <h1>We could not verify this order.</h1>
          <p>Check the reference or contact the event organizer for help.</p>
        </>
      )}
      <p>Reference: <strong>{orderMatchesEvent ? order.reference : "N/A"}</strong></p>
      <a href="/events" class="primary-btn" id="events-link" hidden={paymentStatus === "cancelled" || paymentStatus === "failed"}>Back to events</a>
    </div>
  </div>
</Layout>

<script define:vars={{ reference, paymentStatus }}>
  if (!['paid', 'cancelled', 'failed'].includes(paymentStatus) && reference) {
    const pollIntervalMs = 2500;
    const maxPollCycles = 24;
    let pollCycles = 0;
    let requestInFlight = false;
    let activeRequestController;

    const stopPolling = () => {
      window.clearInterval(pollingInterval);
      activeRequestController?.abort();
    };

    const showTimeout = () => {
      const spinner = document.getElementById('payment-status-spinner');
      const message = document.getElementById('payment-status-message');
      if (spinner) spinner.hidden = true;
      if (message) {
        message.textContent = 'We could not confirm the payment yet. Refresh this page later to check again or contact the event organizer.';
      }
    };

    const showCancelled = () => {
      const spinner = document.getElementById('payment-status-spinner');
      const badge = document.getElementById('payment-status-badge');
      const heading = document.getElementById('payment-status-heading');
      const message = document.getElementById('payment-status-message');
      const failureNotice = document.getElementById('payment-failure-notice');
      const checkoutLink = document.getElementById('payment-checkout-link');
      const eventsLink = document.getElementById('events-link');

      if (spinner) spinner.hidden = true;
      if (badge) {
        badge.textContent = 'Payment not completed';
        badge.classList.remove('checking-badge');
        badge.classList.add('failed-badge');
      }
      if (heading) heading.textContent = 'Your tickets were not issued.';
      if (message) message.hidden = true;
      if (failureNotice) failureNotice.hidden = false;
      if (checkoutLink) checkoutLink.hidden = false;
      if (eventsLink) eventsLink.hidden = true;
    };

    const pollingInterval = window.setInterval(async () => {
      if (pollCycles >= maxPollCycles) {
        stopPolling();
        showTimeout();
        return;
      }

      pollCycles += 1;
      if (requestInFlight) return;

      requestInFlight = true;
      activeRequestController = new AbortController();
      try {
        const response = await fetch('/api/payments/paystack/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          cache: 'no-store',
          signal: activeRequestController.signal,
          body: JSON.stringify({ reference }),
        });
        const result = await response.json();

        if (response.ok) {
          switch (result.status) {
            case 'paid':
              stopPolling();
              window.location.reload();
              return;
            case 'cancelled':
            case 'failed':
              stopPolling();
              showCancelled();
              return;
            case 'pending':
            case 'processing':
              break;
            default:
              break;
          }
        }
      } catch {
        // Keep polling after transient network or verification errors.
      } finally {
        requestInFlight = false;
        activeRequestController = undefined;
      }

      if (pollCycles >= maxPollCycles) {
        stopPolling();
        showTimeout();
      }
    }, pollIntervalMs);
  }
</script>

<style lang="scss">
  @use "../../../styles/partials/combined.scss" as *;

  .success-shell {
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: 7rem 1.25rem 4rem;
  }

  .success-card {
    max-width: 620px;
    width: 100%;
    text-align: center;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 28px;
    padding: 2.2rem;
    box-shadow: 0 30px 60px rgba(17, 24, 39, 0.08);
  }

  .badge {
    display: inline-block;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: rgba(141, 198, 63, 0.12);
    color: #2f6b1a;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .checking-badge {
    background: rgba(245, 158, 11, 0.14);
    color: #92400e;
  }

  .failed-badge {
    background: rgba(220, 38, 38, 0.1);
    color: #991b1b;
  }

  .payment-spinner {
    width: 2rem;
    height: 2rem;
    margin: 0 auto 1rem;
    border: 3px solid rgba(108, 43, 217, 0.18);
    border-top-color: $purple;
    border-radius: 50%;
    animation: payment-spin 0.8s linear infinite;
  }

  .payment-spinner[hidden],
  .payment-failure-notice[hidden],
  #payment-checkout-link[hidden] {
    display: none;
  }

  .payment-failure-notice {
    color: #991b1b;
  }

  @keyframes payment-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .payment-spinner {
      animation: none;
    }
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 4vw, 3.2rem);
  }

  p {
    color: rgba(15, 23, 42, 0.72);
    line-height: 1.8;
    margin-bottom: 1.6rem;
  }

  .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.8rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(135deg, $purple, $green);
    color: $white-pure;
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
  }

  .primary-btn:focus-visible {
    outline: 3px solid $purple;
    outline-offset: 3px;
  }
</style>
